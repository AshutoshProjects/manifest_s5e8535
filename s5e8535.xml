    <project name="android_device_samsung_slsi_sepolicy" path="device/samsung_slsi/sepolicy" remote="devhunter1" />
    <project name="android_hardware_samsung_slsi-linaro_graphics" path="hardware/samsung_slsi-linaro/graphics" remote="devhunter1" />
    <project name="android_hardware_samsung_slsi-linaro_config" path="hardware/samsung_slsi-linaro/config" remote="devhunter1" />
    <project name="android_hardware_samsung_slsi-linaro_exynos" path="hardware/samsung_slsi-linaro/exynos" remote="devhunter1" />
